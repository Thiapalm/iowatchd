#!/usr/bin/env bash
# Shows the alerts logged by iowatchd.
#   iowatchd-log          latest alerts (default: 50 lines)
#   iowatchd-log -f       follow in real time
#   iowatchd-log -s       service status
#   iowatchd-log -h       help
LOG=/var/log/iowatchd.log

case "${1:-}" in
  -f) exec tail -n 20 -F "$LOG" ;;
  -s) if [ -d /run/systemd/system ]; then exec systemctl status iowatchd --no-pager
      elif command -v rc-service >/dev/null 2>&1; then exec rc-service iowatchd status
      else exec sv status iowatchd; fi ;;
  -h|--help) sed -n '2,6p' "$0" ;;
  *)  tail -n "${1:-50}" "$LOG" ;;
esac
