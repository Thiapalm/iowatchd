# Maintainer: Thiapalm <thiago.palmieri@gmail.com>
# Prebuilt (static musl) variant: installs the release binary, no Rust needed.
pkgname=iowatchd-bin
_name=iowatchd
pkgver=0.4.2
pkgrel=1
pkgdesc='Lightweight disk IO monitor that logs which processes cause high IO (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/Thiapalm/iowatchd'
license=('MIT')
provides=("$_name")
conflicts=("$_name")
backup=('etc/iowatchd.conf')
_base="$url/releases/download/v$pkgver/$_name-v$pkgver-linux"
source_x86_64=("$_base-x86_64.tar.gz")
source_aarch64=("$_base-aarch64.tar.gz")
sha256sums_x86_64=('17b481ca72a500c3f813ebe5f7fca6c20b71ea6390550ef014efa71e229b0322')
sha256sums_aarch64=('5b972972248c36e782d680fa77169fe4b485fc6fbd20b99f56bffb73eb8ae025')

package() {
  cd "$_name-v$pkgver-linux-$CARCH"
  make install BIN=iowatchd DESTDIR="$pkgdir" PREFIX=/usr \
    SYSTEMDUNITDIR=/usr/lib/systemd/system
}
