complete -c iowatchd -s c -l config -r -F -d 'configuration file'
complete -c iowatchd -s d -l device -x -a 'auto (awk \'{print $3}\' /proc/diskstats 2>/dev/null)' -d 'disk to monitor'
complete -c iowatchd -s t -l threshold -x -d 'IO usage % that triggers an alert'
complete -c iowatchd -s i -l interval -x -d 'seconds between samples'
complete -c iowatchd -s n -l top -x -d 'processes listed per alert'
complete -c iowatchd -s j -l json -d 'log one JSON object per line'
complete -c iowatchd -s o -l once -d 'take a single measurement and exit'
complete -c iowatchd -s C -l check-config -d 'validate the configuration and exit'
complete -c iowatchd -s f -l foreground -d 'run in the foreground'
complete -c iowatchd -s q -l quiet -d 'do not print to stdout'
complete -c iowatchd -s v -l verbose -d 'print every sample'
complete -c iowatchd -s h -l help -d 'show help'
complete -c iowatchd -s V -l version -d 'show version'

complete -c iowatchd-log -s f -d 'follow in real time'
complete -c iowatchd-log -s s -d 'show service status'
complete -c iowatchd-log -s h -l help -d 'show help'
