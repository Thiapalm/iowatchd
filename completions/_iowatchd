#compdef iowatchd iowatchd-log

case $service in
  iowatchd)
    _arguments \
      '(-c --config)'{-c,--config}'[configuration file]:file:_files' \
      '(-d --device)'{-d,--device}'[disk to monitor]:disk:(auto ${(f)"$(awk "{print \$3}" /proc/diskstats 2>/dev/null)"})' \
      '(-t --threshold)'{-t,--threshold}'[IO usage % that triggers an alert]:percent:' \
      '(-i --interval)'{-i,--interval}'[seconds between samples]:seconds:' \
      '(-n --top)'{-n,--top}'[processes listed per alert]:count:' \
      '(-j --json)'{-j,--json}'[log one JSON object per line]' \
      '(-o --once)'{-o,--once}'[take a single measurement and exit]' \
      '(-C --check-config)'{-C,--check-config}'[validate the configuration and exit]' \
      '(-L --list-devices)'{-L,--list-devices}'[list monitorable disks and exit]' \
      '(-R --report)'{-R,--report}'[summarize the alerts in the log and exit]' \
      '--since[period for --report]:period:' \
      '(-f --foreground)'{-f,--foreground}'[run in the foreground]' \
      '(-q --quiet)'{-q,--quiet}'[do not print to stdout]' \
      '(-v --verbose)'{-v,--verbose}'[print every sample]' \
      '(- *)'{-h,--help}'[show help]' \
      '(- *)'{-V,--version}'[show version]'
    ;;
  iowatchd-log)
    _arguments \
      '(-n --lines)'{-n,--lines}'[show the last N lines]:lines:' \
      '(-f --follow)'{-f,--follow}'[follow in real time]' \
      '--since[only entries since WHEN]:when:' \
      '(-j --json)'{-j,--json}'[only JSON entries]' \
      '(-s --status)'{-s,--status}'[show service status]' \
      '--no-pager[do not page the status output]' \
      '(- *)'{-h,--help}'[show help]' \
      '1:lines:'
    ;;
esac
