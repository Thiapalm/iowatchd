[Unit]
Description=iowatchd - disk IO usage monitor
After=local-fs.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/iowatchd -c /etc/iowatchd.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Runs as root to read /proc/<pid>/io of every process,
# but with privileges and resources reduced to the minimum.
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
CPUQuota=5%
MemoryMax=20M
TasksMax=32

NoNewPrivileges=true
ProtectSystem=strict
# read-only (not true): notify_command must reach /run/user/<uid>/bus to show pop-ups.
ProtectHome=read-only
RuntimeDirectory=iowatchd
PrivateTmp=true
ReadWritePaths=/var/log
# CAP_SETUID/CAP_SETGID: iowatchd-notify drops to the desktop user with runuser.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
