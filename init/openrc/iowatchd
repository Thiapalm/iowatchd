#!/sbin/openrc-run
# OpenRC service for iowatchd.

description="Disk IO usage monitor"
command="/usr/local/bin/iowatchd"
command_args="-c /etc/iowatchd.conf"
supervisor="supervise-daemon"
extra_started_commands="reload"
# Lowest CPU and IO priority.
start_stop_daemon_args="--nicelevel 19 --ionice 3"
output_log="/var/log/iowatchd.out"
error_log="/var/log/iowatchd.out"

depend() {
	need localmount
}

reload() {
	ebegin "Reloading $RC_SVCNAME"
	supervise-daemon "$RC_SVCNAME" --signal HUP
	eend $?
}
